# OpenWeatherMap — free-tier API
# Sign up and get your key at https://openweathermap.org/api
OWM_API_KEY=your_openweathermap_api_key_here

# Coordinates of the location to fetch weather for (decimal degrees)
OWM_LAT=60.1699
OWM_LON=24.9384

# Node-RED container timezone (affects log timestamps and email report labels)
# Does not affect InfluxDB timestamps, which are always UTC.
TZ=Europe/Helsinki

# ---------------------------------------------------------------------------
# InfluxDB credentials and Grafana admin password are NOT env vars.
# They are managed as Docker secrets stored in /mnt/iot-data/secrets/:
#
#   /mnt/iot-data/secrets/influxdb/influxdb2-admin-username
#   /mnt/iot-data/secrets/influxdb/influxdb2-admin-password
#   /mnt/iot-data/secrets/influxdb/influxdb2-admin-token
#
# Create these files manually on the Raspberry Pi before the first
# `docker compose up -d`. They are referenced by docker-compose.yaml
# as Docker secrets and are never passed through environment variables.
# ---------------------------------------------------------------------------
